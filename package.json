{
  "name": "nvc-toolkit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browse feelings or needs by category and pick the ones that fit. Based on the Center for Nonviolent Communication (NVC) word lists.",
  "license": "MIT",
  "author": "Justin Magaram",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmagaram/nvc-obsidian.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run plugin:build",
    "gallery:build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:obsidian": "eslint --config eslint.obsidian.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "plugin:build": "tsc -b && vite build --config vite.plugin.config.ts",
    "plugin:dev": "vite build --config vite.plugin.config.ts --watch --mode deploy",
    "plugin:deploy": "npm run plugin:build && node scripts/deploy-plugin.mjs",
    "version:bump": "node scripts/version-bump.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "oxlint": "^1.79.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
