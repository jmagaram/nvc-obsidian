{
  "name": "nvc-obsidian",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run plugin:build",
    "gallery:build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "plugin:build": "tsc -b && vite build --config vite.plugin.config.ts",
    "plugin:dev": "vite build --config vite.plugin.config.ts --watch --mode deploy",
    "plugin:deploy": "npm run plugin:build && node scripts/deploy-plugin.mjs",
    "version:bump": "node scripts/version-bump.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "obsidian": "^1.13.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
